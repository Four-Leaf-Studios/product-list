{
  "name": "product-list",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.config.ts",
    "build:lib": "vite build -c vite.config.lib.ts",
    "preview": "vite preview"
  },
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
